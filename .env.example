# Browser-side API base. Prefer including /api:
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEMO_CUSTOMER_ID=cus_demo

# Production (Vercel → Environment Variables → Production):
# NEXT_PUBLIC_API_URL=https://reena-rathore-backend.onrender.com/api
#
# If you set only the host (…onrender.com) the app will append /api automatically.
# After changing NEXT_PUBLIC_* on Vercel, redeploy so the value is baked into the JS bundle.
